{
  "name": "@opifer/db",
  "version": "1.2.0",
  "description": "Opifer schema, forward and backward migrations, and embedded Postgres.",
  "license": "AGPL-3.0-only",
  "homepage": "https://opifer.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextEpochs/opifer.git",
    "directory": "packages/db"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "embedded-postgres": "17.10.0-beta.17",
    "postgres": "^3.4.7"
  }
}
