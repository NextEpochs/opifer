{
  "name": "@opifer/server",
  "version": "1.2.1",
  "description": "Opifer HTTP API /v1 and WebSocket events.",
  "license": "AGPL-3.0-only",
  "homepage": "https://opifer.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextEpochs/opifer.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsx watch src/dev.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@opifer/core": "workspace:*",
    "@opifer/db": "workspace:*",
    "@opifer/gateway": "workspace:*",
    "@opifer/provider-anthropic": "workspace:*",
    "@opifer/provider-openai": "workspace:*",
    "@opifer/provider-openai-compatible": "workspace:*",
    "@opifer/runtime": "workspace:*",
    "@opifer/sdk": "workspace:*",
    "@opifer/work": "workspace:*",
    "@opifer/learning": "workspace:*",
    "@opifer/connections": "workspace:*",
    "@opifer/channel-telegram": "workspace:*",
    "fastify": "^5.6.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "ws": "^8.18.0"
  }
}
