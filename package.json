{
  "name": "opifer",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Opifer — AI agents that work, learn and are governed like an organisation.",
  "license": "AGPL-3.0-only",
  "homepage": "https://opifer.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextEpochs/opifer.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './plugins/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' --filter './plugins/**' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r --filter './packages/**' run lint",
    "dev": "pnpm --filter @opifer/server run dev",
    "o4r": "node packages/cli/dist/main.js",
    "third-party-notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "marked": "^18.0.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
