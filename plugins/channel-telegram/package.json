{
  "name": "@opifer/channel-telegram",
  "version": "0.1.0",
  "description": "Telegram channel for Opifer: one bot per company, chats with agents, approvals with buttons.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "opifer": {
    "kind": "channel",
    "permissions": [
      "network:api.telegram.org"
    ]
  },
  "dependencies": {
    "@opifer/sdk": "workspace:*"
  }
}
