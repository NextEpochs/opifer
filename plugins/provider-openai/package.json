{
  "name": "@opifer/provider-openai",
  "version": "1.5.0",
  "description": "OpenAI model provider for Opifer.",
  "license": "MIT",
  "homepage": "https://opifer.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextEpochs/opifer.git",
    "directory": "plugins/provider-openai"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@opifer/sdk": "workspace:*",
    "openai": "^7.20.0"
  },
  "opifer": {
    "kind": "provider",
    "permissions": [
      "network:api.openai.com"
    ]
  }
}
