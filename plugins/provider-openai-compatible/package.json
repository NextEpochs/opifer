{
  "name": "@opifer/provider-openai-compatible",
  "version": "1.0.0",
  "description": "Provider for OpenAI-compatible endpoints: local models with Ollama, vLLM, LM Studio and the like.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "LICENSE"],
  "scripts": { "build": "tsc -b", "typecheck": "tsc -b" },
  "opifer": { "kind": "provider", "permissions": ["network:configured-endpoint"] },
  "dependencies": { "@opifer/provider-openai": "workspace:*", "@opifer/sdk": "workspace:*" }
}
