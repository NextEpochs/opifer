{
  "name": "@opifer/provider-openai-compatible",
  "version": "0.0.1",
  "description": "Provider per endpoint compatibili OpenAI: modelli locali con Ollama, vLLM, LM Studio e simili.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "LICENSE"],
  "scripts": { "build": "tsc -b", "typecheck": "tsc -b" },
  "opifer": { "kind": "provider", "permissions": ["rete:endpoint-configurato"] },
  "dependencies": { "@opifer/provider-openai": "workspace:*", "@opifer/sdk": "workspace:*" }
}
